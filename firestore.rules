rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user has admin custom claim from Firebase Auth
    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.admin == true;
    }
    
    // Check if user is the specific Gmail owner (fallback)
    function isOwner() {
      return isAuthenticated() && 
        request.auth.token.email == "your-gmail-admin@domain.com";
    }
    
    // Check if user is admin OR owner
    function isAdminOrOwner() {
      return isAdmin() || isOwner();
    }
    
    // Helper functions for links
    function canManageLinks() {
      return isAdminOrOwner();
    }
    
    // Helper functions for scan logs
    function canManageScanLogs() {
      return isAdmin(); // Only pure admin can manage scan logs
    }
    
    // Helper functions for admin users
    function canManageAdminUsers() {
      return isAdmin();
    }
    
    // Helper functions for admins collection
    function canManageAdmins() {
      return isAdmin();
    }

    // Links collection
    match /links/{slug} {
      // Public read untuk aktivasi kartu
      allow read: if true;
      
      // Only admin or owner can create/update/delete
      allow create: if canManageLinks();
      allow update: if canManageLinks();
      allow delete: if canManageLinks();
    }
    
    // Scan Logs collection
    match /scanLogs/{logId} {
      // Public create untuk scan logging
      allow create: if true;
      
      // Only admin can read/delete
      allow read: if canManageScanLogs();
      allow update: if false; // Scan logs immutable
      allow delete: if canManageScanLogs();
    }
    
    // Admin Users collection
    match /adminUsers/{userId} {
      allow read, write: if canManageAdminUsers();
    }
    
    // Admins collection (used for login)
    match /admins/{adminId} {
      allow read, write: if canManageAdmins();
    }
  }
}